#!/usr/bin/env bash
# ==============================================================================
# QDeck: Spaces Workspace Switcher & Alt+Tab HUD Controller
# Supports: qdeck-spaces, qdeck spaces, qdeck-space, qdeck space
# ==============================================================================
set -euo pipefail

CMD="${1:-toggle}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

# Source shared IPC helper
if [[ -f "$SCRIPT_DIR/lib/qdeck-ipc.sh" ]]; then
  source "$SCRIPT_DIR/lib/qdeck-ipc.sh"
elif [[ -f "$HOME/.local/bin/lib/qdeck-ipc.sh" ]]; then
  source "$HOME/.local/bin/lib/qdeck-ipc.sh"
elif command -v qdeck-ipc >/dev/null 2>&1; then
  source "$(command -v qdeck-ipc)"
fi

# Hyprland direct fallback if QuickShell IPC is offline or starting
hypr_fallback() {
  local action="$1"
  if command -v hyprctl >/dev/null 2>&1; then
    local cur_ws=1
    if command -v jq >/dev/null 2>&1; then
      cur_ws=$(hyprctl activeworkspace -j 2>/dev/null | jq -r '.id // 1' 2>/dev/null || echo 1)
    fi
    local target_ws=1
    case "$action" in
      next|toggle)
        if [[ "$cur_ws" -ge 10 ]]; then
          target_ws=1
        else
          target_ws=$((cur_ws + 1))
        fi
        ;;
      prev)
        if [[ "$cur_ws" -le 1 ]]; then
          target_ws=10
        else
          target_ws=$((cur_ws - 1))
        fi
        ;;
      *)
        return 0
        ;;
    esac
    hyprctl dispatch "hl.dsp.focus({ workspace = $target_ws })" 2>/dev/null || hyprctl dispatch workspace "$target_ws" 2>/dev/null || true
  fi
}

invoke_spaces() {
  local method="$1"; shift
  call_ipc spaces "$method" "$@" 2>/dev/null || call_ipc space "$method" "$@" 2>/dev/null || hypr_fallback "$method"
}

case "$CMD" in
  toggle)
    invoke_spaces toggle
    ;;
  open|show)
    invoke_spaces open
    ;;
  close|hide)
    invoke_spaces close
    ;;
  next|cycle)
    invoke_spaces next
    ;;
  prev)
    invoke_spaces prev
    ;;
  peek)
    WS_ID="${2:-1}"
    invoke_spaces peek "$WS_ID"
    ;;
  status|is-visible)
    invoke_spaces isVisible
    ;;
  *)
    invoke_spaces toggle
    ;;
esac

