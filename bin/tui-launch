#!/usr/bin/env bash

tui="$1"

if [[ -z "$tui" ]]; then
  echo "Usage: $0 <tui-command>"
  exit 1
fi

class="tui-$tui"

case "$tui" in
  default-package-manager|default-pkg-manager|pkg-manager|qdeck-pkg)
    address=$(
      hyprctl clients -j 2>/dev/null |
        jq -r --arg class "$class" \
          '.[] | select(.class == $class or .class == "qdeck-pkg" or .class == "tui-default-package-manager" or .class == "tui-qdeck-pkg" or (.class | startswith("pkg-"))) | .address' 2>/dev/null |
        head -n1
    )
    ;;
  *)
    address=$(
      hyprctl clients -j 2>/dev/null |
        jq -r --arg class "$class" \
          '.[] | select(.class == $class) | .address' 2>/dev/null |
        head -n1
    )
    ;;
esac

if [[ -n "$address" ]]; then
  hyprctl dispatch "hl.dsp.focus({ window = \"address:$address\" })"
else
  kitty \
    --class "$class" \
    --title "$tui" \
    -e "$tui"
fi