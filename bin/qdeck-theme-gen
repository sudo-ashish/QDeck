#!/usr/bin/env python3
"""
QDeck: Dynamic Theme & GTK Generator (qdeck-theme-gen)
Compiles runtime application color configurations:
  - gtk-4.0.css for GTK 4.0 / Libadwaita
  - gtk-3.0.css for GTK 3.0
  - color.conf for Kitty
  - hyprlock-color.conf for Hyprlock
  - btop.theme for btop
directly from the single source of truth: colors.toml.
"""

import sys
import os
import tomllib
from pathlib import Path


def hex_to_rgb(hex_str: str) -> tuple[int, int, int]:
    """Convert hex string (#rrggbb or #rgb) to RGB tuple."""
    h = hex_str.lstrip("#")
    if len(h) == 3:
        h = "".join([c * 2 for c in h])
    elif len(h) != 6:
        return 0, 0, 0
    return int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)


def rgb_to_hex(r: int, g: int, b: int) -> str:
    """Convert RGB integers to 6-digit hex string with #."""
    return f"#{max(0, min(255, r)):02x}{max(0, min(255, g)):02x}{max(0, min(255, b)):02x}"


def adjust_brightness(hex_str: str, factor: float) -> str:
    """Scale color brightness by factor (< 1.0 darkens, > 1.0 lightens)."""
    r, g, b = hex_to_rgb(hex_str)
    return rgb_to_hex(int(r * factor), int(g * factor), int(b * factor))


def normalize_hex(color_val: str, default: str = "#000000") -> str:
    """Ensure color string has leading '#' and valid format."""
    if not color_val:
        return default
    c = str(color_val).strip()
    if not c.startswith("#"):
        c = f"#{c}"
    return c


def compile_theme(theme_dir: Path) -> bool:
    """Compile color.conf, hyprlock-color.conf, btop.theme, gtk-3.0.css, and gtk-4.0.css."""
    toml_path = theme_dir / "colors.toml"
    if not toml_path.is_file():
        print(f"Error: No colors.toml found in {theme_dir}", file=sys.stderr)
        return False

    try:
        with open(toml_path, "rb") as f:
            raw_c = tomllib.load(f)
    except Exception as e:
        print(f"Error parsing {toml_path}: {e}", file=sys.stderr)
        return False

    c = {k: normalize_hex(v) for k, v in raw_c.items() if isinstance(v, str)}

    # Primary colors & fallbacks
    background = c.get("background", "#1e1e2e")
    foreground = c.get("foreground", "#cdd6f4")
    accent = c.get("accent", c.get("blue", "#89b4fa"))
    selection = c.get("selection", c.get("selection_background", c.get("color0", "#292e42")))
    muted = c.get("muted", c.get("dark_foreground", c.get("color8", "#585b70")))
    cursor = c.get("cursor", c.get("bright_foreground", c.get("foreground", "#f5e0dc")))

    # Surfaces
    dark_background = c.get("dark_background", c.get("color0", adjust_brightness(background, 0.85)))
    darker_background = c.get("darker_background", adjust_brightness(dark_background, 0.80))
    lighter_background = c.get("lighter_background", selection if selection != background else adjust_brightness(background, 1.15))

    # Typography
    dark_foreground = c.get("dark_foreground", muted)
    light_foreground = c.get("light_foreground", c.get("color7", foreground))
    bright_foreground = c.get("bright_foreground", c.get("color15", cursor))

    selection_fg = c.get("selection_foreground", background)
    selection_bg = c.get("selection_background", selection)

    # Semantic colors
    red = c.get("red", c.get("color1", "#f38ba8"))
    green = c.get("green", c.get("color2", "#a6e3a1"))
    yellow = c.get("yellow", c.get("color3", "#f9e2af"))
    orange = c.get("orange", c.get("color11", yellow))
    blue = c.get("blue", c.get("color4", accent))
    magenta = c.get("magenta", c.get("color5", "#f5c2e7"))
    cyan = c.get("cyan", c.get("color6", "#94e2d5"))
    brown = c.get("brown", "#75493d")

    # High-vibrancy variants
    bright_red = c.get("bright_red", c.get("color9", red))
    bright_green = c.get("bright_green", c.get("color10", green))
    bright_yellow = c.get("bright_yellow", c.get("color11", yellow))
    bright_blue = c.get("bright_blue", c.get("color12", blue))
    bright_magenta = c.get("bright_magenta", c.get("color13", magenta))
    bright_cyan = c.get("bright_cyan", c.get("color14", cyan))

    # Base16 ANSI colors
    color0 = c.get("color0", selection)
    color1 = c.get("color1", red)
    color2 = c.get("color2", green)
    color3 = c.get("color3", yellow)
    color4 = c.get("color4", accent)
    color5 = c.get("color5", magenta)
    color6 = c.get("color6", cyan)
    color7 = c.get("color7", light_foreground)
    color8 = c.get("color8", muted)
    color9 = c.get("color9", bright_red)
    color10 = c.get("color10", bright_green)
    color11 = c.get("color11", bright_yellow)
    color12 = c.get("color12", bright_blue)
    color13 = c.get("color13", bright_magenta)
    color14 = c.get("color14", bright_cyan)
    color15 = c.get("color15", bright_foreground)

    # 1. Generate Kitty color.conf
    color_conf_content = f"""# Generated by qdeck-theme-gen from colors.toml. DO NOT EDIT MANUALLY.
background {background}
foreground {foreground}
url_color {accent}
cursor {cursor}
selection_foreground {selection_fg}
selection_background {selection_bg}

color0 {color0}
color1 {color1}
color2 {color2}
color3 {color3}
color4 {color4}
color5 {color5}
color6 {color6}
color7 {color7}
color8 {color8}
color9 {color9}
color10 {color10}
color11 {color11}
color12 {color12}
color13 {color13}
color14 {color14}
color15 {color15}
"""

    # 2. Generate Hyprlock hyprlock-color.conf
    bg_clean = background.lstrip("#")
    fg_clean = foreground.lstrip("#")
    accent_clean = accent.lstrip("#")
    selection_clean = selection.lstrip("#")
    muted_clean = muted.lstrip("#")
    red_clean = red.lstrip("#")
    green_clean = green.lstrip("#")
    yellow_clean = yellow.lstrip("#")

    hyprlock_conf_content = f"""# Generated by qdeck-theme-gen from colors.toml. DO NOT EDIT MANUALLY.
$background = rgb({bg_clean})
$foreground = rgb({fg_clean})
$accent = rgb({accent_clean})
$selection = rgb({selection_clean})
$muted = rgb({muted_clean})
$red = rgb({red_clean})
$green = rgb({green_clean})
$yellow = rgb({yellow_clean})
"""

    # 3. Generate btop.theme
    btop_theme_content = f"""# Generated by qdeck-theme-gen from colors.toml. DO NOT EDIT MANUALLY.
theme[main_bg]="{background}"
theme[main_fg]="{foreground}"
theme[title]="{foreground}"
theme[hi_fg]="{accent}"
theme[selected_bg]="{selection}"
theme[selected_fg]="{bright_foreground}"
theme[inactive_fg]="{muted}"
theme[graph_text]="{foreground}"
theme[meter_bg]="{selection}"
theme[proc_misc]="{accent}"

theme[cpu_box]="{color4}"
theme[mem_box]="{color2}"
theme[net_box]="{color1}"
theme[proc_box]="{color4}"
theme[div_line]="{muted}"

theme[temp_start]="{green}"
theme[temp_mid]="{yellow}"
theme[temp_end]="{red}"

theme[cpu_start]="{cyan}"
theme[cpu_mid]="{blue}"
theme[cpu_end]="{magenta}"

theme[free_start]="{magenta}"
theme[free_mid]="{cyan}"
theme[free_end]="{blue}"

theme[cached_start]="{cyan}"
theme[cached_mid]="{blue}"
theme[cached_end]="{magenta}"

theme[available_start]="{orange}"
theme[available_mid]="{yellow}"
theme[available_end]="{red}"

theme[used_start]="{green}"
theme[used_mid]="{yellow}"
theme[used_end]="{red}"

theme[download_start]="{orange}"
theme[download_mid]="{yellow}"
theme[download_end]="{red}"

theme[upload_start]="{green}"
theme[upload_mid]="{cyan}"
theme[upload_end]="{blue}"

theme[process_start]="{cyan}"
theme[process_mid]="{blue}"
theme[process_end]="{magenta}"
"""

    # 4. Generate GTK 4.0 / Libadwaita & GTK 3.0 CSS
    gtk_css_content = f"""/* Generated by qdeck-theme-gen from colors.toml. DO NOT EDIT MANUALLY. */

/* ── Accent Colors ── */
@define-color accent_color {accent};
@define-color accent_bg_color {accent};
@define-color accent_fg_color {darker_background};

/* ── Window & View Surfaces ── */
@define-color window_bg_color {background};
@define-color window_fg_color {foreground};
@define-color view_bg_color {dark_background};
@define-color view_fg_color {foreground};

/* ── Headerbar & Titlebar ── */
@define-color headerbar_bg_color {darker_background};
@define-color headerbar_fg_color {foreground};
@define-color headerbar_border_color {selection};
@define-color headerbar_backdrop_color {dark_background};
@define-color headerbar_shade_color rgba(0, 0, 0, 0.36);

/* ── Sidebar & Secondary Panes (Nautilus / Settings) ── */
@define-color sidebar_bg_color {dark_background};
@define-color sidebar_fg_color {foreground};
@define-color sidebar_backdrop_color {darker_background};
@define-color sidebar_shade_color rgba(0, 0, 0, 0.25);
@define-color secondary_sidebar_bg_color {darker_background};
@define-color secondary_sidebar_fg_color {foreground};
@define-color secondary_sidebar_backdrop_color {darker_background};

/* ── Cards, Dialogs & Popovers ── */
@define-color card_bg_color {lighter_background};
@define-color card_fg_color {foreground};
@define-color card_shade_color rgba(0, 0, 0, 0.20);
@define-color dialog_bg_color {dark_background};
@define-color dialog_fg_color {foreground};
@define-color popover_bg_color {dark_background};
@define-color popover_fg_color {foreground};
@define-color popover_shade_color rgba(0, 0, 0, 0.25);
@define-color thumbnail_bg_color {dark_background};
@define-color thumbnail_fg_color {foreground};

/* ── Semantic Status Colors ── */
@define-color destructive_color {red};
@define-color destructive_bg_color {red};
@define-color destructive_fg_color {darker_background};
@define-color success_color {green};
@define-color success_bg_color {green};
@define-color success_fg_color {darker_background};
@define-color warning_color {yellow};
@define-color warning_bg_color {yellow};
@define-color warning_fg_color {darker_background};
@define-color error_color {red};
@define-color error_bg_color {red};
@define-color error_fg_color {darker_background};

/* ── Borders & Shades ── */
@define-color borders {selection};
@define-color shade_color rgba(0, 0, 0, 0.36);
@define-color scrollbar_outline_color rgba(0, 0, 0, 0.5);

/* ── Legacy GTK3 Theme Compatibility Aliases ── */
@define-color theme_bg_color {background};
@define-color theme_fg_color {foreground};
@define-color theme_base_color {dark_background};
@define-color theme_text_color {foreground};
@define-color theme_selected_bg_color {accent};
@define-color theme_selected_fg_color {darker_background};
@define-color insensitive_bg_color {darker_background};
@define-color insensitive_fg_color {muted};
@define-color insensitive_base_color {dark_background};
@define-color theme_unfocused_bg_color {background};
@define-color theme_unfocused_fg_color {muted};
@define-color theme_unfocused_base_color {dark_background};
@define-color theme_unfocused_text_color {foreground};
@define-color theme_unfocused_selected_bg_color {selection};
@define-color theme_unfocused_selected_fg_color {foreground};

/* ── Modern Libadwaita (1.6+) CSS Variables & Overrides ── */
:root, window, .background {{
  --accent-color: {accent};
  --accent-bg-color: {accent};
  --accent-fg-color: {darker_background};
  --window-bg-color: {background};
  --window-fg-color: {foreground};
  --view-bg-color: {dark_background};
  --view-fg-color: {foreground};
  --headerbar-bg-color: {darker_background};
  --headerbar-fg-color: {foreground};
  --headerbar-border-color: {selection};
  --headerbar-backdrop-color: {dark_background};
  --sidebar-bg-color: {dark_background};
  --sidebar-fg-color: {foreground};
  --sidebar-backdrop-color: {darker_background};
  --secondary-sidebar-bg-color: {darker_background};
  --secondary-sidebar-fg-color: {foreground};
  --secondary-sidebar-backdrop-color: {darker_background};
  --card-bg-color: {lighter_background};
  --card-fg-color: {foreground};
  --dialog-bg-color: {dark_background};
  --dialog-fg-color: {foreground};
  --popover-bg-color: {dark_background};
  --popover-fg-color: {foreground};
  --destructive-color: {red};
  --destructive-bg-color: {red};
  --destructive-fg-color: {darker_background};
  --success-color: {green};
  --success-bg-color: {green};
  --success-fg-color: {darker_background};
  --warning-color: {yellow};
  --warning-bg-color: {yellow};
  --warning-fg-color: {darker_background};
  --error-color: {red};
  --error-bg-color: {red};
  --error-fg-color: {darker_background};
  --border-color: {selection};
  --borders: {selection};
}}

window.background {{
  background-color: var(--window-bg-color);
  color: var(--window-fg-color);
}}
"""

    color_conf_path = theme_dir / "color.conf"
    hyprlock_conf_path = theme_dir / "hyprlock-color.conf"
    btop_theme_path = theme_dir / "btop.theme"
    gtk3_path = theme_dir / "gtk-3.0.css"
    gtk4_path = theme_dir / "gtk-4.0.css"

    try:
        color_conf_path.write_text(color_conf_content, encoding="utf-8")
        hyprlock_conf_path.write_text(hyprlock_conf_content, encoding="utf-8")
        btop_theme_path.write_text(btop_theme_content, encoding="utf-8")
        gtk3_path.write_text(gtk_css_content, encoding="utf-8")
        gtk4_path.write_text(gtk_css_content, encoding="utf-8")
    except Exception as e:
        print(f"Error writing compiled configs in {theme_dir}: {e}", file=sys.stderr)
        return False

    return True


def main():
    config_home = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
    default_target = config_home / "themes" / "current"

    args = sys.argv[1:]

    if not args:
        target_dir = default_target
        if not target_dir.exists():
            print(f"Target theme directory does not exist: {target_dir}", file=sys.stderr)
            sys.exit(1)
        if compile_theme(target_dir):
            sys.exit(0)
        sys.exit(1)

    if args[0] in ("-h", "--help"):
        print("Usage: qdeck-theme-gen [THEME_DIR | --all]")
        print("Compiles color.conf, hyprlock-color.conf, btop.theme, and gtk-3.0/4.0.css dynamically from colors.toml.")
        sys.exit(0)

    if args[0] == "--all":
        themes_dir = config_home / "themes"
        if not themes_dir.is_dir():
            repo_themes = Path(__file__).resolve().parent.parent / "themes"
            if repo_themes.is_dir():
                themes_dir = repo_themes

        count = 0
        for item in sorted(themes_dir.iterdir()):
            if item.is_dir() and not item.is_symlink() and item.name != "current":
                if compile_theme(item):
                    count += 1
        print(f"Compiled dynamic runtime configs for {count} themes.")
        sys.exit(0)

    target_dir = Path(args[0]).resolve()
    if not target_dir.exists():
        print(f"Error: Target directory does not exist: {target_dir}", file=sys.stderr)
        sys.exit(1)

    if compile_theme(target_dir):
        sys.exit(0)
    sys.exit(1)


if __name__ == "__main__":
    main()
