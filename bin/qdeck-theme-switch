#!/usr/bin/env bash
# QDeck: Theme discovery, listing, and switching helper (qdeck-theme-switch / qdeck theme)
set -euo pipefail

THEMES_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/themes"
CURRENT_LINK="$THEMES_DIR/current"
SETUP_BIN="$HOME/.local/bin/theme-switch-setup"
SWITCH_BIN="$HOME/.local/bin/theme-switch"

# Ensure binaries in PATH if available
if ! command -v theme-switch >/dev/null 2>&1 && [[ -x "$SWITCH_BIN" ]]; then
    export PATH="$HOME/.local/bin:$PATH"
fi

get_current_theme() {
    if [[ -L "$CURRENT_LINK" ]]; then
        basename "$(readlink -f "$CURRENT_LINK")"
    else
        echo ""
    fi
}

list_themes_json() {
    local cur
    cur="$(get_current_theme)"

    if [[ ! -d "$THEMES_DIR" ]]; then
        echo "[]"
        return 0
    fi

    local items=()
    shopt -s nullglob
    for dir in "$THEMES_DIR"/*; do
        [[ -d "$dir" && ! -L "$dir" ]] || continue
        local id
        id="$(basename "$dir")"
        [[ "$id" == .* || "$id" == "current" ]] && continue

        # Find first wallpaper matching standard formats
        local wallpaper=""
        if [[ -d "$dir/backgrounds" ]]; then
            for img in "$dir/backgrounds"/*; do
                [[ -f "$img" ]] || continue
                case "${img,,}" in
                    *.png|*.jpg|*.jpeg|*.webp|*.avif|*.bmp)
                        wallpaper="$img"
                        break
                        ;;
                esac
            done
        fi

        # Fallback to default.png or any direct image if backgrounds is empty
        if [[ -z "$wallpaper" && -f "$dir/default.png" ]]; then
            wallpaper="$(readlink -f "$dir/default.png" 2>/dev/null || echo "$dir/default.png")"
        fi

        # Human-readable display name
        local name
        name="$(echo "$id" | sed -E 's/[-_]+/ /g; s/\b([a-z])/\U\1/g')"

        local is_current=false
        if [[ "$id" == "$cur" ]]; then
            is_current=true
        fi

        # Try to read accent color from colors.toml
        local accent=""
        if [[ -f "$dir/colors.toml" ]]; then
            accent="$(grep -E '^[[:space:]]*accent[[:space:]]*=' "$dir/colors.toml" 2>/dev/null | head -n1 | sed -E 's/^[[:space:]]*accent[[:space:]]*=[[:space:]]*["'\'']?([^"'\''";]+)["'\'']?.*/\1/' | xargs)"
            if [[ -n "$accent" && "$accent" != \#* ]]; then
                accent="#$accent"
            fi
        fi

        items+=( "$(jq -n \
            --arg id "$id" \
            --arg name "$name" \
            --arg wallpaper "$wallpaper" \
            --arg accent "$accent" \
            --argjson isCurrent "$is_current" \
            '{id: $id, name: $name, wallpaper: $wallpaper, accent: $accent, isCurrent: $isCurrent}')" )
    done
    shopt -u nullglob

    if [[ ${#items[@]} -eq 0 ]]; then
        echo "[]"
    else
        printf "%s\n" "${items[@]}" | jq -s .
    fi
}

switch_theme() {
    local theme="${1:-}"
    if [[ -z "$theme" ]]; then
        echo "error: theme argument missing" >&2
        exit 1
    fi

    local target_dir="$THEMES_DIR/$theme"
    if [[ ! -d "$target_dir" ]]; then
        echo "error: theme '$theme' does not exist in $THEMES_DIR" >&2
        exit 1
    fi

    mkdir -p "$THEMES_DIR"

    # 1. Update active theme symlink atomically
    ln -sfn "$target_dir" "$CURRENT_LINK"

    # 2. If dedicated theme-switch utility exists, execute it for deep editor & app integrations
    if command -v theme-switch >/dev/null 2>&1; then
        theme-switch "$theme" 2>/dev/null || true
    elif [[ -x "$SWITCH_BIN" ]]; then
        "$SWITCH_BIN" "$theme" 2>/dev/null || true
    fi

    # 3. Synchronize active wallpaper if theme contains one
    local wp=""
    if [[ -d "$target_dir/backgrounds" ]]; then
        for img in "$target_dir/backgrounds"/*; do
            [[ -f "$img" ]] || continue
            case "${img,,}" in
                *.png|*.jpg|*.jpeg|*.webp|*.avif|*.bmp)
                    wp="$img"
                    break
                    ;;
            esac
        done
    fi
    if [[ -z "$wp" && -f "$target_dir/default.png" ]]; then
        wp="$target_dir/default.png"
    fi

    if [[ -n "$wp" ]]; then
        if command -v qdeck-wallpaper >/dev/null 2>&1; then
            qdeck-wallpaper apply "$wp" >/dev/null 2>&1 &
        elif command -v awww >/dev/null 2>&1 && (pgrep -x awww-daemon >/dev/null 2>&1 || true); then
            awww load "$wp" 2>/dev/null || true
        fi
    fi

    # 4. Reload Hyprland if running so color.conf changes take effect
    if command -v hyprctl >/dev/null 2>&1; then
        hyprctl reload >/dev/null 2>&1 || true
    fi

    # 4b. Notify Quickshell to immediately re-read ~/.config/themes/current/colors.toml
    if command -v qs >/dev/null 2>&1; then
        qs ipc call theme reload >/dev/null 2>&1 || true
    fi
    if command -v quickshell >/dev/null 2>&1; then
        quickshell ipc call theme reload >/dev/null 2>&1 || true
    fi

    echo "Switched to theme: $theme"
}

run_setup() {
    if command -v theme-switch-setup >/dev/null 2>&1; then
        theme-switch-setup 2>/dev/null || true
    elif [[ -x "$SETUP_BIN" ]]; then
        "$SETUP_BIN" 2>/dev/null || true
    fi
}

CMD="${1:-list}"
case "$CMD" in
    list|get)
        list_themes_json
        ;;
    current)
        get_current_theme
        ;;
    switch|apply)
        shift
        switch_theme "$@"
        ;;
    setup)
        run_setup
        ;;
    *)
        echo "Usage: $0 {list|current|switch <theme>|setup}" >&2
        exit 1
        ;;
esac
