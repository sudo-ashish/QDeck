#!/usr/bin/env bash
# qdeck-pkg — QDeck Package Manager launcher
# Launches qdeck-pkg-tui (Rust binary) inside kitty or foot.
# Auto-builds the binary on first run if missing.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BIN_DIR="$SCRIPT_DIR"
PKG_TUI="$BIN_DIR/qdeck-pkg-tui"
NATIVE_DIR="$BIN_DIR/../native/package-manager"

# ── Dependency checks ──────────────────────────────────────────────────────

if ! command -v yay &>/dev/null; then
  echo "qdeck-pkg: error: 'yay' is not installed." >&2
  if command -v notify-send &>/dev/null; then
    notify-send "QDeck Package Manager" "yay is required. Install it from AUR first." \
      --urgency=critical 2>/dev/null || true
  fi
  exit 1
fi

# ── Build binary on first run ──────────────────────────────────────────────

if [[ ! -x "$PKG_TUI" ]]; then
  if ! command -v cargo &>/dev/null; then
    echo "qdeck-pkg: error: Rust/Cargo is not installed. Cannot build qdeck-pkg-tui." >&2
    echo "  Install with: curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh" >&2
    exit 1
  fi

  echo "qdeck-pkg: building package manager binary (first run, please wait)..."
  if cargo build --release --manifest-path "$NATIVE_DIR/Cargo.toml" 2>&1; then
    cp "$NATIVE_DIR/target/release/qdeck-pkg" "$PKG_TUI"
    chmod +x "$PKG_TUI"
    echo "qdeck-pkg: build complete."
  else
    echo "qdeck-pkg: build failed." >&2
    exit 1
  fi
fi

# ── Launch in terminal ─────────────────────────────────────────────────────

# If already inside an interactive terminal, run the binary directly
if [[ -t 0 && -t 1 ]]; then
  exec "$PKG_TUI" "$@"
fi

TITLE="QDeck Package Manager"
CLASS="qdeck-pkg"

if command -v kitty &>/dev/null; then
  exec kitty \
    --title "$TITLE" \
    --class "$CLASS" \
    -- "$PKG_TUI" "$@"
elif command -v foot &>/dev/null; then
  exec foot \
    --title "$TITLE" \
    --app-id "$CLASS" \
    -- "$PKG_TUI" "$@"
else
  # Fallback: run directly in current terminal
  exec "$PKG_TUI" "$@"
fi
