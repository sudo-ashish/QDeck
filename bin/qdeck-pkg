#!/usr/bin/env bash
# ==============================================================================
# QDeck: Package Manager Launcher (Quickshell Launcher Integration)
# Opens or toggles the package search and installation view in QDeck launcher.
# ==============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Source shared IPC helper
if [[ -f "$SCRIPT_DIR/lib/qdeck-ipc.sh" ]]; then
  source "$SCRIPT_DIR/lib/qdeck-ipc.sh"
elif [[ -f "$HOME/.local/bin/lib/qdeck-ipc.sh" ]]; then
  source "$HOME/.local/bin/lib/qdeck-ipc.sh"
elif command -v qdeck-ipc >/dev/null 2>&1; then
  source "$(command -v qdeck-ipc)"
fi

if [[ $# -eq 0 ]]; then
  call_ipc packages toggle
  exit 0
fi

case "$1" in
  toggle)
    call_ipc packages toggle
    ;;
  open)
    shift || true
    if [[ $# -gt 0 ]]; then
      call_ipc packages search "$*"
    else
      call_ipc packages open
    fi
    ;;
  search)
    shift || true
    call_ipc packages search "$*"
    ;;
  close)
    call_ipc packages close
    ;;
  --help|-h|help)
    cat <<EOF
QDeck Package Manager (Launcher Integration)

Usage:
  qdeck-pkg                  Toggle package manager view in launcher
  qdeck-pkg <query>          Open package manager with search query
  qdeck-pkg toggle           Toggle package manager
  qdeck-pkg open             Open package manager
  qdeck-pkg search <query>   Open package manager with search query
  qdeck-pkg close            Close package manager
EOF
    exit 0
    ;;
  *)
    # Treat arguments as search query
    call_ipc packages search "$*"
    ;;
esac
