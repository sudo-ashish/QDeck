#!/usr/bin/env python3
"""
QDeck: Fast Package Search Engine (Arch Linux Official + AUR)
Streams JSON lines to stdout with intelligent relevance ranking:
{"name": "...", "version": "...", "description": "...", "source": "official"|"aur", "repo": "...", "installed": true|false}
"""

import sys
import json
import urllib.request
import urllib.parse
import subprocess
import threading
import queue

def get_installed_set():
    try:
        out = subprocess.check_output(["pacman", "-Qq"], text=True, stderr=subprocess.DEVNULL)
        return set(out.splitlines())
    except Exception:
        return set()

def calc_rank(name, query):
    n = name.lower()
    q = query.lower()
    if n == q:
        return (0, len(n))
    if n.startswith(q):
        return (1, len(n))
    if q in n:
        return (2, len(n))
    return (3, len(n))

def search_official(query, installed_set, out_queue):
    items = []
    try:
        proc = subprocess.Popen(
            ["pacman", "-Ss", query],
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True
        )
        lines = []
        for line in proc.stdout:
            lines.append(line.rstrip("\n"))
        proc.wait()

        i = 0
        while i < len(lines):
            line = lines[i].strip()
            if not line:
                i += 1
                continue
            parts = line.split()
            if len(parts) >= 2:
                repo_name = parts[0]
                version = parts[1]
                if "/" in repo_name:
                    repo, name = repo_name.split("/", 1)
                else:
                    repo, name = "official", repo_name
                desc = ""
                if i + 1 < len(lines) and lines[i + 1].startswith("    "):
                    desc = lines[i + 1].strip()
                    i += 1
                item = {
                    "name": name,
                    "version": version,
                    "description": desc,
                    "source": "official",
                    "repo": repo,
                    "installed": name in installed_set
                }
                items.append(item)
            i += 1
    except Exception:
        pass

    # Sort official items by relevance
    items.sort(key=lambda x: calc_rank(x["name"], query))
    for item in items:
        out_queue.put(item)
    out_queue.put({"_official_done": True})

def search_aur(query, installed_set, out_queue):
    items = []
    try:
        encoded_q = urllib.parse.quote(query)
        url = f"https://aur.archlinux.org/rpc/v5/search/{encoded_q}?by=name-desc"
        req = urllib.request.Request(
            url,
            headers={"User-Agent": "qdeck-pkg/1.0 (Arch Linux)"}
        )
        with urllib.request.urlopen(req, timeout=3.5) as response:
            data = json.loads(response.read().decode("utf-8"))
            results = data.get("results", [])
            for r in results[:50]:
                name = r.get("Name", "")
                if not name:
                    continue
                item = {
                    "name": name,
                    "version": r.get("Version", ""),
                    "description": r.get("Description", "") or "",
                    "source": "aur",
                    "repo": "aur",
                    "installed": name in installed_set
                }
                items.append(item)
    except Exception:
        try:
            out = subprocess.check_output(
                ["yay", "-Ss", "--aur", query],
                text=True,
                stderr=subprocess.DEVNULL,
                timeout=3.0
            )
            lines = out.splitlines()
            i = 0
            while i < len(lines) and i < 80:
                line = lines[i].strip()
                if not line:
                    i += 1
                    continue
                parts = line.split()
                if len(parts) >= 2 and parts[0].startswith("aur/"):
                    name = parts[0].replace("aur/", "")
                    version = parts[1]
                    desc = ""
                    if i + 1 < len(lines) and lines[i + 1].startswith("    "):
                        desc = lines[i + 1].strip()
                        i += 1
                    item = {
                        "name": name,
                        "version": version,
                        "description": desc,
                        "source": "aur",
                        "repo": "aur",
                        "installed": name in installed_set
                    }
                    items.append(item)
                i += 1
        except Exception:
            pass

    # Sort AUR items by relevance
    items.sort(key=lambda x: calc_rank(x["name"], query))
    for item in items:
        out_queue.put(item)
    out_queue.put({"_aur_done": True})

def main():
    if len(sys.argv) < 2:
        sys.exit(0)
    query = sys.argv[1].strip()
    if not query:
        sys.exit(0)

    installed_set = get_installed_set()
    out_queue = queue.Queue()

    t_off = threading.Thread(target=search_official, args=(query, installed_set, out_queue), daemon=True)
    t_aur = threading.Thread(target=search_aur, args=(query, installed_set, out_queue), daemon=True)

    t_off.start()
    t_aur.start()

    seen_names = set()
    done_count = 0
    max_results = 80
    emitted = 0

    while done_count < 2 and emitted < max_results:
        try:
            item = out_queue.get(timeout=4.0)
            if "_official_done" in item or "_aur_done" in item:
                done_count += 1
                continue
            name = item.get("name")
            if name and name not in seen_names:
                seen_names.add(name)
                print(json.dumps(item), flush=True)
                emitted += 1
        except queue.Empty:
            break

if __name__ == "__main__":
    try:
        main()
    except BrokenPipeError:
        try:
            sys.stdout.close()
        except Exception:
            pass
        sys.exit(0)
