#!/usr/bin/env bash
# QDeck: System terminal launcher (qdeck-launch-terminal / qdeck terminal)
set -euo pipefail

TERM_BIN=""
for t in kitty foot "${TERMINAL:-}" alacritty ghostty wezterm gnome-terminal xfce4-terminal xterm; do
  if [[ -n "$t" ]] && command -v "$t" >/dev/null 2>&1; then
    TERM_BIN="$t"
    break
  fi
done

if [[ -z "$TERM_BIN" ]]; then
  echo "No terminal emulator found" >&2
  exit 1
fi

case "$TERM_BIN" in
  kitty)
    exec kitty "$@"
    ;;
  foot)
    exec foot "$@"
    ;;
  alacritty)
    if [[ $# -gt 0 ]]; then
      exec alacritty -e "$@"
    else
      exec alacritty
    fi
    ;;
  ghostty)
    if [[ $# -gt 0 ]]; then
      exec ghostty -e "$@"
    else
      exec ghostty
    fi
    ;;
  wezterm)
    if [[ $# -gt 0 ]]; then
      exec wezterm start -- "$@"
    else
      exec wezterm start
    fi
    ;;
  *)
    if [[ $# -gt 0 ]]; then
      exec "$TERM_BIN" -e "$@"
    else
      exec "$TERM_BIN"
    fi
    ;;
esac
