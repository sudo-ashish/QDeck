#!/usr/bin/env bash
# ==============================================================================
# QDeck: Default Package Manager Launcher & Selector (default-package-manager)
#
# Launches the configured default package manager (or focuses an existing window).
# Allows selecting and persisting the default package manager across sessions.
# ==============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BIN_DIR="$SCRIPT_DIR"

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/qdeck"
CONFIG_FILE="$CONFIG_DIR/default-package-manager"

# Ensure local bin is in PATH
if [[ -d "$HOME/.local/bin" ]] && [[ ":$PATH:" != *":$HOME/.local/bin:"* ]]; then
  export PATH="$HOME/.local/bin:$PATH"
fi

get_default() {
  if [[ -f "$CONFIG_FILE" ]]; then
    local saved
    saved="$(tr -d '[:space:]' < "$CONFIG_FILE")"
    if [[ -n "$saved" ]]; then
      echo "$saved"
      return 0
    fi
  fi
  echo "qdeck-pkg"
}

set_default() {
  local target="$1"
  mkdir -p "$CONFIG_DIR"
  echo "$target" > "$CONFIG_FILE"
  echo "==> Default package manager set to: $target"
  if command -v notify-send &>/dev/null; then
    notify-send "QDeck Package Manager" "Default package manager set to: $target" \
      --icon=system-software-install 2>/dev/null || true
  fi
}

# Known candidate package managers
# Format: binary_name|Display Label|Type (tui/gui/cli)
CANDIDATES=(
  "qdeck-pkg|QDeck Package Manager (Rust + Ratatui TUI)|tui"
  "yay|Yay (Yet Another Yogurt - AUR & Pacman helper)|cli"
  "paru|Paru (Feature-packed AUR helper)|cli"
  "pacman|Pacman (Official Arch Linux Package Manager)|cli"
  "pamac-manager|Pamac (GUI Software Manager)|gui"
  "bauh|Bauh (Graphical Package Manager)|gui"
  "octopi|Octopi (Pacman GUI frontend)|gui"
  "discover|KDE Discover (Software Center)|gui"
  "gnome-software|GNOME Software Center|gui"
)

select_interactive() {
  # If not running in a terminal, launch inside kitty
  if [[ ! -t 0 ]]; then
    if command -v kitty &>/dev/null; then
      exec kitty \
        --title "QDeck: Select Default Package Manager" \
        --class "qdeck-pkg-select" \
        -- "$0" --select
    elif command -v foot &>/dev/null; then
      exec foot \
        --title "QDeck: Select Default Package Manager" \
        --app-id "qdeck-pkg-select" \
        -- "$0" --select
    fi
  fi

  local current
  current="$(get_default)"

  # Filter available package managers
  local options=()
  local labels=()
  for entry in "${CANDIDATES[@]}"; do
    IFS="|" read -r bin label typ <<< "$entry"
    if command -v "$bin" &>/dev/null || [[ "$bin" == "qdeck-pkg" && -x "$BIN_DIR/qdeck-pkg" ]]; then
      if [[ "$bin" == "$current" ]]; then
        labels+=("$label [current default]")
      else
        labels+=("$label")
      fi
      options+=("$bin")
    fi
  done

  if [[ ${#options[@]} -eq 0 ]]; then
    echo "No supported package managers found on system." >&2
    exit 1
  fi

  echo "================================================="
  echo "       QDeck Default Package Manager             "
  echo "================================================="
  echo "Current: $current"
  echo ""

  local chosen_bin=""

  if command -v gum &>/dev/null; then
    echo "Select default package manager:"
    local choice
    choice=$(gum choose "${labels[@]}" || true)
    [[ -z "$choice" ]] && exit 0
    for i in "${!labels[@]}"; do
      if [[ "${labels[$i]}" == "$choice" ]]; then
        chosen_bin="${options[$i]}"
        break
      fi
    done
  elif command -v fzf &>/dev/null; then
    local choice
    choice=$(printf '%s\n' "${labels[@]}" | fzf --prompt="Select Default Package Manager> " --height=40% --reverse || true)
    [[ -z "$choice" ]] && exit 0
    for i in "${!labels[@]}"; do
      if [[ "${labels[$i]}" == "$choice" ]]; then
        chosen_bin="${options[$i]}"
        break
      fi
    done
  else
    echo "Select an option:"
    select choice in "${labels[@]}" "Cancel"; do
      if [[ "$choice" == "Cancel" || -z "$choice" ]]; then
        exit 0
      fi
      local idx=$((REPLY - 1))
      if [[ $idx -ge 0 && $idx -lt ${#options[@]} ]]; then
        chosen_bin="${options[$idx]}"
        break
      fi
    done
  fi

  if [[ -n "$chosen_bin" ]]; then
    set_default "$chosen_bin"
  fi
}

focus_window_by_class() {
  local target_class="$1"
  if command -v hyprctl &>/dev/null && command -v jq &>/dev/null; then
    local addr
    addr=$(hyprctl clients -j 2>/dev/null | jq -r --arg class "$target_class" '.[] | select(.class == $class) | .address' 2>/dev/null | head -n1 || true)
    if [[ -n "$addr" && "$addr" != "null" ]]; then
      hyprctl dispatch focuswindow "address:$addr" >/dev/null 2>&1 || true
      return 0
    fi
  fi
  return 1
}

launch_target() {
  local target="$1"
  shift || true

  case "$target" in
    qdeck-pkg)
      if focus_window_by_class "qdeck-pkg"; then
        exit 0
      fi
      if [[ -x "$BIN_DIR/qdeck-pkg" ]]; then
        exec "$BIN_DIR/qdeck-pkg" "$@"
      elif command -v qdeck-pkg &>/dev/null; then
        exec qdeck-pkg "$@"
      else
        echo "error: qdeck-pkg not found" >&2
        exit 1
      fi
      ;;
    yay|paru|pacman)
      local cls="pkg-$target"
      if focus_window_by_class "$cls"; then
        exit 0
      fi
      local title="Package Manager ($target)"
      if command -v kitty &>/dev/null; then
        exec kitty --class "$cls" --title "$title" -- "$target" "$@"
      elif command -v foot &>/dev/null; then
        exec foot --app-id "$cls" --title "$title" -- "$target" "$@"
      else
        exec "$target" "$@"
      fi
      ;;
    pamac-manager|bauh|octopi|discover|gnome-software)
      if focus_window_by_class "$target"; then
        exit 0
      fi
      exec "$target" "$@"
      ;;
    *)
      # Arbitrary custom command
      if command -v "$target" &>/dev/null; then
        exec "$target" "$@"
      else
        echo "error: configured package manager '$target' not found" >&2
        exit 1
      fi
      ;;
  esac
}

# ── Argument parsing ───────────────────────────────────────────────────────

if [[ $# -gt 0 ]]; then
  case "$1" in
    --select|-s|select)
      select_interactive
      exit 0
      ;;
    --set)
      if [[ $# -lt 2 ]]; then
        echo "Usage: $0 --set <package-manager>" >&2
        exit 1
      fi
      set_default "$2"
      exit 0
      ;;
    --get|-g|get)
      get_default
      exit 0
      ;;
    --help|-h|help)
      cat <<EOF
QDeck: Default Package Manager Launcher & Selector

Usage:
  default-package-manager [options] [args...]
  qdeck pkg [options] [args...]

Options:
  --select, -s         Interactively choose and save default package manager
  --set <manager>      Set default package manager directly (e.g. qdeck-pkg, yay, paru)
  --get, -g            Display current default package manager
  --help, -h           Show this help message

If no options are given, launches the configured default package manager
(focusing an existing window if already open).
EOF
      exit 0
      ;;
  esac
fi

# Launch current default
DEFAULT_MGR="$(get_default)"
launch_target "$DEFAULT_MGR" "$@"
