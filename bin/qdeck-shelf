#!/usr/bin/env bash
# QDeck: Drag-and-Drop Staging Shelf controller (qdeck-shelf / qdeck shelf)
set -euo pipefail

CMD="${1:-toggle}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

# Choose CLI binary
if command -v qs >/dev/null 2>&1; then
  QS_BIN="qs"
else
  QS_BIN="quickshell"
fi

call_ipc() {
  local target="$1"; shift
  local method="$1"; shift
  local out=""

  # 1. Try generic IPC call first (directly connects to active running QuickShell)
  if out=$("$QS_BIN" ipc call "$target" "$method" "$@" 2>&1); then
    printf '%s\n' "$out"
    return 0
  fi

  # 2. Try explicit QUICKSHELL_DIR if set
  if [[ -n "${QUICKSHELL_DIR:-}" && -d "$QUICKSHELL_DIR" ]]; then
    if out=$("$QS_BIN" -p "$QUICKSHELL_DIR" ipc call "$target" "$method" "$@" 2>&1); then
      printf '%s\n' "$out"
      return 0
    fi
  fi

  # 3. Try standard user configuration ~/.config/quickshell
  if [[ -d "$HOME/.config/quickshell" ]]; then
    if out=$("$QS_BIN" -p "$HOME/.config/quickshell" ipc call "$target" "$method" "$@" 2>&1); then
      printf '%s\n' "$out"
      return 0
    fi
  fi

  # 4. Try workspace configuration in repository
  if [[ -d "$REPO_DIR/quickshell" ]]; then
    if out=$("$QS_BIN" -p "$REPO_DIR/quickshell" ipc call "$target" "$method" "$@" 2>&1); then
      printf '%s\n' "$out"
      return 0
    fi
  fi

  return 1
}

case "$CMD" in
  toggle)
    call_ipc shelf toggle
    ;;
  open|show)
    call_ipc shelf open
    ;;
  close|hide)
    call_ipc shelf close
    ;;
  clear)
    call_ipc shelf clear
    ;;
  list)
    call_ipc shelf list
    ;;
  count)
    call_ipc shelf count
    ;;
  add)
    shift
    for file in "$@"; do
      call_ipc shelf add "$file"
    done
    ;;
  remove|delete)
    shift
    call_ipc shelf remove "$1"
    ;;
  *)
    call_ipc shelf "$CMD" "${@:2}"
    ;;
esac
