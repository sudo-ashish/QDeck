#!/usr/bin/env bash
# QDeck: Manage top bar visibility and status (qdeck-bar / qdeck bar)
# Layout: Centered compact notch bar (content-fitted dynamic width)

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell"
VIS_FILE="$CONFIG_DIR/bar-visibility"

is_bar_visible() {
  if [[ -f "$VIS_FILE" ]]; then
    local v
    v="$(tr -d '[:space:]' < "$VIS_FILE" | tr '[:upper:]' '[:lower:]')"
    if [[ "$v" == "hidden" || "$v" == "false" || "$v" == "hide" || "$v" == "off" ]]; then
      echo "hidden"
      return 0
    fi
  fi
  echo "visible"
}

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Source shared IPC helper
if [[ -f "$SCRIPT_DIR/lib/qdeck-ipc.sh" ]]; then
  source "$SCRIPT_DIR/lib/qdeck-ipc.sh"
elif [[ -f "$HOME/.local/bin/lib/qdeck-ipc.sh" ]]; then
  source "$HOME/.local/bin/lib/qdeck-ipc.sh"
elif command -v qdeck-ipc >/dev/null 2>&1; then
  source "$(command -v qdeck-ipc)"
fi

call_bar_ipc() {
  call_ipc "$@" >/dev/null 2>&1 || true
}

set_bar_visibility() {
  local state="$1" # "visible" or "hidden"
  mkdir -p "$CONFIG_DIR"
  echo "$state" > "$VIS_FILE"

  if [[ "$state" == "hidden" ]]; then
    call_bar_ipc bar hide
    echo "Top bar is now hidden."
  else
    call_bar_ipc bar show
    echo "Top bar is now visible."
  fi
}

toggle_bar_visibility() {
  local res
  res="$(call_ipc bar toggle 2>/dev/null || true)"
  if [[ "$res" == "visible" || "$res" == "hidden" ]]; then
    mkdir -p "$CONFIG_DIR"
    echo "$res" > "$VIS_FILE"
    echo "Top bar is now $res."
    return 0
  fi

  local cur
  cur="$(is_bar_visible)"
  if [[ "$cur" == "hidden" ]]; then
    set_bar_visibility "visible"
  else
    set_bar_visibility "hidden"
  fi
}

show_help() {
  cat <<EOF
Usage: qdeck bar [COMMAND]
       qdeck-bar [COMMAND]

Manage QDeck top bar visibility and status.
Layout is locked to the centered compact notch design.

Commands:
  status (default)    Show current active bar status and visibility
  toggle              Toggle top bar visibility on/off
  hide                Hide the top bar
  show                Show the top bar
  help, -h, --help    Show this help message

Examples:
  qdeck bar               # Show current visibility status
  qdeck bar toggle        # Toggle top bar on/off
  qdeck bar hide          # Hide top bar
  qdeck bar show          # Show top bar
EOF
}

cmd="${1:-status}"

case "$cmd" in
  status)
    vis="$(is_bar_visible)"
    echo "Current bar layout: compact (status: $vis)"
    ;;

  toggle|toggle-bar)
    toggle_bar_visibility
    ;;

  hide|hide-bar)
    set_bar_visibility "hidden"
    ;;

  show|show-bar)
    set_bar_visibility "visible"
    ;;

  list)
    echo "Available QDeck Bar Layout Modes:"
    echo "  * compact (active & default)"
    ;;

  compact)
    echo "QDeck top bar is in compact layout mode."
    ;;

  next|prev|floating|islands|wide)
    echo "Notice: Multi-mode switching has been deprecated. QDeck now uses the compact notch bar layout exclusively."
    ;;

  help|-h|--help)
    show_help
    ;;

  *)
    echo "Error: Unknown bar command: '$cmd'" >&2
    echo "Run 'qdeck bar help' to see available options." >&2
    exit 1
    ;;
esac
