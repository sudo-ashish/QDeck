#!/usr/bin/env bash
# QDeck: Manage top bar visibility, modes, and status (qdeck-bar / qdeck bar)
# Modes:
#   compact - Standard centered compact notch bar with all widgets
#   clock   - Minimal clock pill showing only time; expands to full bar on hover

CONFIG_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/quickshell"
VIS_FILE="$CONFIG_DIR/bar-visibility"
MODE_FILE="$CONFIG_DIR/bar-mode"
MODES=("compact" "clock")
DEFAULT_MODE="compact"

is_bar_visible() {
  if [[ -f "$VIS_FILE" ]]; then
    local v
    v="$(tr -d '[:space:]' < "$VIS_FILE" | tr '[:upper:]' '[:lower:]')"
    if [[ "$v" == "hidden" || "$v" == "false" || "$v" == "hide" || "$v" == "off" ]]; then
      echo "hidden"
      return 0
    fi
  fi
  echo "visible"
}

get_current_mode() {
  if [[ -f "$MODE_FILE" ]]; then
    local m
    m="$(tr -d '[:space:]' < "$MODE_FILE" | tr '[:upper:]' '[:lower:]')"
    if [[ "$m" == "clock" || "$m" == "minimal" || "$m" == "peek" || "$m" == "clock-pill" ]]; then
      echo "clock"
      return 0
    elif [[ "$m" == "compact" || "$m" == "normal" || "$m" == "full" ]]; then
      echo "compact"
      return 0
    fi
  fi
  echo "$DEFAULT_MODE"
}

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# Source shared IPC helper
if [[ -f "$SCRIPT_DIR/lib/qdeck-ipc.sh" ]]; then
  source "$SCRIPT_DIR/lib/qdeck-ipc.sh"
elif [[ -f "$HOME/.local/bin/lib/qdeck-ipc.sh" ]]; then
  source "$HOME/.local/bin/lib/qdeck-ipc.sh"
elif command -v qdeck-ipc >/dev/null 2>&1; then
  source "$(command -v qdeck-ipc)"
fi

call_bar_ipc() {
  call_ipc "$@" >/dev/null 2>&1 || true
}

set_bar_visibility() {
  local state="$1" # "visible" or "hidden"
  mkdir -p "$CONFIG_DIR"
  echo "$state" > "$VIS_FILE"

  if [[ "$state" == "hidden" ]]; then
    call_bar_ipc bar hide
    echo "Top bar is now hidden."
  else
    call_bar_ipc bar show
    echo "Top bar is now visible."
  fi
}

toggle_bar_visibility() {
  local res
  res="$(call_ipc bar toggle 2>/dev/null || true)"
  if [[ "$res" == "visible" || "$res" == "hidden" ]]; then
    mkdir -p "$CONFIG_DIR"
    echo "$res" > "$VIS_FILE"
    echo "Top bar is now $res."
    return 0
  fi

  local cur
  cur="$(is_bar_visible)"
  if [[ "$cur" == "hidden" ]]; then
    set_bar_visibility "visible"
  else
    set_bar_visibility "hidden"
  fi
}

set_mode() {
  local target="$1"
  mkdir -p "$CONFIG_DIR"
  echo "$target" > "$MODE_FILE"
  call_bar_ipc barpopups setMode "$target"
  echo "QDeck bar layout mode set to: $target"
}

toggle_mode() {
  local cur
  cur="$(get_current_mode)"
  if [[ "$cur" == "clock" ]]; then
    set_mode "compact"
  else
    set_mode "clock"
  fi
}

show_help() {
  cat <<EOF
Usage: qdeck bar [COMMAND|MODE]
       qdeck-bar [COMMAND|MODE]

Manage QDeck top bar layout modes and visibility.

Commands:
  status (default)    Show current active bar mode and visibility
  toggle              Toggle top bar visibility on/off
  hide                Hide the top bar
  show                Show the top bar
  mode                Toggle between compact and clock modes
  list                List all available layout modes
  help, -h, --help    Show this help message

Modes:
  compact             Standard compact notch bar (always shows all widgets)
  clock               Minimal time-only clock pill; expands to full bar on hover

Examples:
  qdeck bar               # Show current mode and visibility
  qdeck bar clock         # Switch to minimal clock pill mode (expands on hover)
  qdeck bar compact       # Switch to standard compact notch bar
  qdeck bar mode          # Toggle between compact and clock modes
  qdeck bar toggle        # Toggle top bar on/off
  qdeck bar hide          # Hide top bar
  qdeck bar show          # Show top bar
EOF
}

cmd="${1:-status}"

case "$cmd" in
  status)
    current="$(get_current_mode)"
    vis="$(is_bar_visible)"
    echo "Current bar layout: $current (status: $vis)"
    ;;

  toggle|toggle-bar)
    toggle_bar_visibility
    ;;

  hide|hide-bar)
    set_bar_visibility "hidden"
    ;;

  show|show-bar)
    set_bar_visibility "visible"
    ;;

  list)
    current="$(get_current_mode)"
    echo "Available QDeck Bar Layout Modes:"
    for m in "${MODES[@]}"; do
      if [[ "$m" == "$current" ]]; then
        echo "  * $m (active)"
      else
        echo "    $m"
      fi
    done
    ;;

  compact|normal|full)
    set_mode "compact"
    ;;

  clock|minimal|peek|clock-pill)
    set_mode "clock"
    ;;

  mode|toggle-mode|cycle|next)
    toggle_mode
    ;;

  help|-h|--help)
    show_help
    ;;

  *)
    echo "Error: Unknown bar command: '$cmd'" >&2
    echo "Run 'qdeck bar help' to see available options." >&2
    exit 1
    ;;
esac
