#!/usr/bin/env bash
# QDeck: Dynamic Dual Alpha + Hyprland blur controller (qdeck-blur / qdeck blur)
set -euo pipefail

CMD="${1:-toggle}"
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Source shared IPC helper
if [[ -f "$SCRIPT_DIR/lib/qdeck-ipc.sh" ]]; then
  source "$SCRIPT_DIR/lib/qdeck-ipc.sh"
elif [[ -f "$HOME/.local/bin/lib/qdeck-ipc.sh" ]]; then
  source "$HOME/.local/bin/lib/qdeck-ipc.sh"
elif command -v qdeck-ipc >/dev/null 2>&1; then
  source "$(command -v qdeck-ipc)"
fi

case "$CMD" in
  toggle)
    res=$(call_ipc theme toggleBlur)
    echo "Blur is now: $res"
    ;;
  on|enable|true|1)
    res=$(call_ipc theme setBlur on)
    echo "Blur is now: $res"
    ;;
  off|disable|false|0)
    res=$(call_ipc theme setBlur off)
    echo "Blur is now: $res"
    ;;
  status|get)
    res=$(call_ipc theme getBlur)
    echo "Blur is: $res"
    ;;
  *)
    echo "Usage: qdeck-blur [toggle|on|off|status]" >&2
    exit 1
    ;;
esac
