#!/usr/bin/env bash
# qdeck-wsswitcher — Windows Alt+Tab-style Workspace Switcher
# Usage:
#   qdeck-wsswitcher [toggle|open|close|next|prev]
set -euo pipefail

CMD="${1:-toggle}"

case "$CMD" in
  toggle|open|close|next|prev|confirm)
    qs ipc call wsswitcher "$CMD"
    ;;
  *)
    echo "Usage: qdeck-wsswitcher [toggle|open|close|next|prev|confirm]" >&2
    exit 1
    ;;
esac

